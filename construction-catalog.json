  "tshirt_setin_engineering_v1": {
    "id": "tshirt_setin_engineering_v1",
    "name": "Футболка с втачным рукавом",
    "category": "tshirt",
    "variant": "Короткий втачной рукав, круглая горловина и сложенная рибана",
    "status": "experimental",
    "implementation_version": "1.0.0",
    "coordinate_system": "x_right_y_down_mm",
    "fit_verified": false,
    "required_measurements": [
      "chest",
      "shoulder_width",
      "chest_width",
      "back_width",
      "armhole_depth",
      "biceps",
      "head"
    ],
    "required_parameters": [
      "length_mm",
      "chest_ease_mm",
      "hem_circumference_mm",
      "sleeve_length_mm",
      "cuff_circumference_mm",
      "neck_width_mm",
      "front_neck_depth_mm",
      "back_neck_depth_mm",
      "shoulder_drop_mm",
      "biceps_ease_mm",
      "armhole_ease_mm",
      "rib_stretch_percent",
      "rib_recovery_percent",
      "rib_application_extension_percent",
      "body_stretch_percent"
    ],
    "required_roles": [
      "front",
      "back",
      "sleeve_left",
      "sleeve_right",
      "neckband"
    ],
    "parameter_ranges": {
      "length_mm": [
        400,
        1000
      ],
      "chest_ease_mm": [
        40,
        240
      ],
      "hem_circumference_mm": [
        600,
        1800
      ],
      "sleeve_length_mm": [
        150,
        400
      ],
      "cuff_circumference_mm": [
        180,
        650
      ],
      "neck_width_mm": [
        100,
        260
      ],
      "front_neck_depth_mm": [
        40,
        180
      ],
      "back_neck_depth_mm": [
        10,
        60
      ],
      "shoulder_drop_mm": [
        10,
        60
      ],
      "biceps_ease_mm": [
        30,
        140
      ],
      "armhole_ease_mm": [
        0,
        40
      ],
      "rib_stretch_percent": [
        5,
        150
      ],
      "rib_recovery_percent": [
        90,
        100
      ],
      "rib_application_extension_percent": [
        1,
        40
      ],
      "body_stretch_percent": [
        0,
        100
      ],
      "shoulder_width_mm": [
        250,
        600
      ]
    },
    "defaults": {
      "seam_allowance_mm": 7,
      "binding_width_mm": 15
    },
    "sources": [
      "https://freesewing.eu/docs/designs/library/options/",
      "https://freesewing.eu/docs/designs/onyx/options/neckbandlength/",
      "https://freesewing.eu/docs/designs/teagan/"
    ],
    "formulas": {
      "body_chest_half": "(chest + chest_ease_mm) / 4",
      "shoulder_end_x": "shoulder_width_mm / 2; initial value = measured shoulder_width",
      "front_pitch_x": "chest_width / 2 + chest_ease_mm / 8",
      "back_pitch_x": "back_width / 2 + chest_ease_mm / 8",
      "armhole_y": "armhole_depth + armhole_ease_mm",
      "sleeve_solver": "L(cap_front) = L(front_armhole); L(cap_back) = L(back_armhole); front_span + back_span = biceps + biceps_ease_mm",
      "neckband_length": "L(front_neck + back_neck) / (1 + rib_application_extension_percent / 100)",
      "neckband_width": "2 * binding_width_mm + 2 * seam_allowance_mm (cut width)"
    },
    "limits": [
      "Собственная экспериментальная основа; не Müller, ЕМКО или ЦОТШЛ",
      "Без вытачек, отрицательных прибавок и индивидуальной коррекции осанки",
      "Плечевой баланс требует примерки; перед и спинка одинаковой длины",
      "Равномерный припуск; подгибку низа определить отдельно",
      "Долевая и надсечки CLO требуют ручного назначения",
      "Максимальная растяжимость не заменяет пробу притачивания рибаны"
    ],
    "length_tolerance_mm": 0.2,
    "curve_tolerance_mm": 0.1,
    "solver_tolerance_mm": 0.005
  },
  "trousers_utility_v1": {
    "construction_revision": "utility_1",
